<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.SubtitleCat</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.SubtitleCat</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Version>1.0.0.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Jellyfin.Controller / Jellyfin.Model pull in MediaBrowser.Controller,
      MediaBrowser.Common and MediaBrowser.Model. Pin this to the major.minor
      of the Jellyfin server you are targeting. 10.11.*-* matches whatever
      the latest published 10.11.x server prerelease/stable package is.
      If you're building for 10.9 or 10.10 instead, change this string
      accordingly (e.g. "10.9.*-*") and re-restore.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*-*" IncludeAssets="compile" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
